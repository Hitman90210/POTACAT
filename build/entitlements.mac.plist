<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 need JIT + writable-executable memory under the hardened
       runtime, or the renderer crashes on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The Remote Launcher relaunches the app as Node via ELECTRON_RUN_AS_NODE
       (scripts/launcher.js), which the hardened runtime blocks without this. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- We load native N-API addons (ft8_native, js8_native, alsa_native, opus)
       and run bundled helpers (cloudflared, rigctld). Library validation would
       reject any that isn't signed by our team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Microphone: ECHOCAT remote audio + Local Rig FT8/JS8 receive. The usage
       string is in the mac.extendInfo Info.plist. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
